{
  "name": "velo-pdf",
  "private": true,
  "version": "1.0.0",
  "description": "Blazing-fast, installable PWA PDF viewer for huge files: instant open, jump, zoom and search. Offline and 100% local.",
  "license": "MIT",
  "author": "adirel",
  "homepage": "https://jolly-horse-319b11.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adirel/velo-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/adirel/velo-pdf/issues"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf-reader",
    "pdfjs",
    "pwa",
    "offline",
    "large-files",
    "performance",
    "typescript",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "build:preview": "npm run build && vite preview --port 4173",
    "demo-pdf": "node scripts/make-demo-pdf.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "social-card": "node scripts/make-social-card.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}

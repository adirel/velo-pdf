{
  "name": "pdf-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "build:preview": "npm run build && vite preview --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
